INSERT INTO "Articles" ("Title", "Slug", "Description", "Content", "ImageUrl", "IsPublished", "PublishedAt", "CreatedAt", "UpdatedAt", "AuthorFullName", "ImageDescription")
SELECT
    'Choosing bamboo poles for tropical builds',
    'choosing-bamboo-poles-for-builds',
    'Diameter, age class, and moisture checks that save rework on site.',
    'Bamboo looks simple until you load it. Start with the structural chart from your engineer, then match pole class to span and connector detail.'
    || E'\n\nOn receipt, skim for cracks at nodes, spiral shakes, and bore holes. A quick moisture spot-check helps you decide whether to acclimatize before install.'
    || E'\n\nWhen in doubt, step up one diameter class or specify treated stock for ground contact and wet rooms.',
    'https://images.unsplash.com/photo-1598900384379-02b0883e4952?w=1200&h=750&fit=crop',
    true, (NOW() AT TIME ZONE 'UTC'), (NOW() AT TIME ZONE 'UTC'), (NOW() AT TIME ZONE 'UTC'),
    'Mara Ramos', 'Fresh-cut bamboo poles stacked at a supplier yard.'
