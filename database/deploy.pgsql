INSERT INTO "LegalPages" ("Slug", "Title", "Body", "LastRevised", "IsPublished", "UpdatedAt")
SELECT 'privacy-policy', 'Privacy Policy',
    'This Privacy Policy describes how {{company_name}} ("we", "us") collects, uses, and protects personal information when you visit our website or contact us.'
    || E'\n\nInformation we collect: name, email, phone, and messages sent through our contact form; basic technical data in server logs.'
    || E'\n\nHow we use information: to respond to inquiries, deliver services, improve our website, and meet legal obligations. We do not sell your personal information.'
    || E'\n\nCookies: we use essential cookies for site operation. If analytics are enabled later, this policy will be updated.'
    || E'\n\nYour rights: contact us through the email on our Contact page to request access, correction, or deletion of your data.',
    CURRENT_DATE, true, (NOW() AT TIME ZONE 'UTC')
WHERE NOT EXISTS (SELECT 1 FROM "LegalPages" WHERE "Slug" = 'privacy-policy');

INSERT INTO "LegalPages" ("Slug", "Title", "Body", "LastRevised", "IsPublished", "UpdatedAt")
