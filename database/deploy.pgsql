-- Services catalog
INSERT INTO "Services" ("Title", "Description", "IconUrl", "ImageUrl")
SELECT v."Title", v."Description", v."IconUrl", v."ImageUrl"
FROM (VALUES
    ('Raw Bamboo Poles', 'Available in various lengths (3m, 6m, 9m) and diameters. Suitable for construction, scaffolding, garden structures, and fencing. Sold per pole or in bulk.', NULL, 'https://images.unsplash.com/photo-1598900384379-02b0883e4952?w=600&h=400&fit=crop'),
    ('Treated Bamboo Lumber', 'Kiln-dried and pressure-treated for extended lifespan. Resistant to insects, moisture, and warping. Ideal for flooring, decking, and structural framing.', NULL, 'https://images.unsplash.com/photo-1501004318641-b39e0a090e8e?w=600&h=400&fit=crop'),
    ('Woven Bamboo Panels', 'Hand-woven panels in various weave patterns. Used for interior walls, ceilings, furniture backing, and decorative partitions. Natural and stained finishes available.', NULL, 'https://images.unsplash.com/photo-1518531933037-91b2f5f229cc?w=600&h=400&fit=crop'),
    ('Bamboo Stakes & Garden Poles', 'Thin, lightweight poles for plant support, trellises, and agricultural use. Available in bundles of 50 or 100.', NULL, 'https://images.unsplash.com/photo-1416879595882-3373a0480b5b?w=600&h=400&fit=crop'),
    ('Bulk & Wholesale Supply', 'Volume pricing for contractors, furniture manufacturers, and exporters. Minimum order quantities apply. Contact us for a custom quote.', NULL, 'https://images.unsplash.com/photo-1585320806297-9794b3e4eeae?w=600&h=400&fit=crop'),
    ('Custom Cut Orders', 'Need a non-standard size or a specific treatment? We accept custom orders with a 5-7 business day lead time.', NULL, 'https://images.unsplash.com/photo-1503387763038-714adcc6aa3d?w=600&h=400&fit=crop')
) AS v("Title", "Description", "IconUrl", "ImageUrl")
WHERE NOT EXISTS (SELECT 1 FROM "Services");

-- Administrator (password: Admin123!)
DO $$
DECLARE
    admin_role_id integer;
    admin_user_id integer;
BEGIN
    IF NOT EXISTS (SELECT 1 FROM "Users") THEN
        INSERT INTO "Roles" ("Name") VALUES ('Administrator')
        RETURNING "Id" INTO admin_role_id;

        INSERT INTO "RolePermissions" ("RoleId", "Permission") VALUES
            (admin_role_id, 'content.manage'),
            (admin_role_id, 'media.manage');

        INSERT INTO "Users" ("Email", "PasswordHash", "DisplayName", "IsActive")
        VALUES (
            'admin@kawayan.com',
            '$2a$11$cwABrJoUwTw/ZfsjXdhUJeaMJknwJQ20/0qe.sGCbi4sN6FW872he',
            'Administrator',
            true
        )
        RETURNING "Id" INTO admin_user_id;

        INSERT INTO "UserRoles" ("UserId", "RoleId")
        VALUES (admin_user_id, admin_role_id);
    END IF;
END $$;

DELETE FROM "RolePermissions" WHERE "Permission" = 'settings.manage';

