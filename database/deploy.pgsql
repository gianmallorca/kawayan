/*
================================================================================
 kawayan - Unified Database Deploy Script (PostgreSQL)
================================================================================
 (Brand: kaw.a.yan — Baybayin ᜃᜏ᜔.ᜀᜌ᜔.ᜀᜈ᜔; backend identifiers: kawayan)

 Purpose   : Apply EF schema + seed data to PostgreSQL (idempotent / safe to re-run)
 Database  : PostgreSQL 16+ (matches InitialPostgres migration)
 Migration : 20260524042919_InitialPostgres

 Usage     :
   psql "postgresql://user:pass@host:5432/dbname" -f database/deploy.sql
   Railway → connect to Postgres service → Query tab → paste/run

 Regenerate schema block:
   dotnet ef migrations script --idempotent -p src/kawayan.API -o database/_schema.postgresql.sql

 Legacy SQL Server script: database/deploy.sqlserver.sql
================================================================================
*/

/* =============================================================================
   STEP 1 - EF Core schema (Initialising InitialPostgres)
   ============================================================================= */

CREATE TABLE IF NOT EXISTS "__EFMigrationsHistory" (
    "MigrationId" character varying(150) NOT NULL,
    "ProductVersion" character varying(32) NOT NULL,
    CONSTRAINT "PK___EFMigrationsHistory" PRIMARY KEY ("MigrationId")
);

START TRANSACTION;

DO $EF$
BEGIN
    IF NOT EXISTS(SELECT 1 FROM "__EFMigrationsHistory" WHERE "MigrationId" = '20260524042919_InitialPostgres') THEN
    CREATE TABLE "Articles" (
        "Id" integer GENERATED BY DEFAULT AS IDENTITY,
        "Title" text NOT NULL,
        "Slug" text NOT NULL,
        "Description" text NOT NULL,
        "Content" text NOT NULL,
        "ImageUrl" text,
        "ImageDescription" text NOT NULL,
        "AuthorFullName" text NOT NULL,
        "IsPublished" boolean NOT NULL,
        "PublishedAt" timestamp without time zone,
        "CreatedAt" timestamp without time zone NOT NULL,
        "UpdatedAt" timestamp without time zone NOT NULL,
        CONSTRAINT "PK_Articles" PRIMARY KEY ("Id")
    );
    END IF;
END $EF$;

DO $EF$
BEGIN
    IF NOT EXISTS(SELECT 1 FROM "__EFMigrationsHistory" WHERE "MigrationId" = '20260524042919_InitialPostgres') THEN
    CREATE TABLE "CompanyDetails" (
        "Id" integer NOT NULL,
        "NameMain" text NOT NULL,
        "NameBaybayin" text NOT NULL,
        "Tagline" text NOT NULL,
        "LogoUrl" text,
        "PrimaryColor" text NOT NULL,
        "Email" text NOT NULL,
        "Phone" text NOT NULL,
        "Street" text NOT NULL,
        "Barangay" text NOT NULL,
        "City" text NOT NULL,
        "Province" text NOT NULL,
        "Region" text NOT NULL,
        "Country" text NOT NULL,
        "PostalCode" text NOT NULL,
        "Latitude" numeric(9,6),
        "Longitude" numeric(9,6),
        "Website" text NOT NULL,
        "SocialLinksJson" text NOT NULL,
        "CoverImageUrl" text,
        "AboutImageUrl" text,
        "EstablishedYear" integer,
        "ShortDescription" text NOT NULL,
        "FullDescription" text NOT NULL,
        "UpdatedAt" timestamp without time zone NOT NULL,
        CONSTRAINT "PK_CompanyDetails" PRIMARY KEY ("Id")
    );
    END IF;
END $EF$;

DO $EF$
BEGIN
    IF NOT EXISTS(SELECT 1 FROM "__EFMigrationsHistory" WHERE "MigrationId" = '20260524042919_InitialPostgres') THEN
    CREATE TABLE "Inquiries" (
        "Id" integer GENERATED BY DEFAULT AS IDENTITY,
        "SenderName" text NOT NULL,
        "SenderEmail" text NOT NULL,
        "Phone" text NOT NULL,
        "Subject" text NOT NULL,
        "Message" text NOT NULL,
        "IsRead" boolean NOT NULL,
        "CreatedAt" timestamp without time zone NOT NULL,
        CONSTRAINT "PK_Inquiries" PRIMARY KEY ("Id")
    );
    END IF;
END $EF$;

DO $EF$
BEGIN
    IF NOT EXISTS(SELECT 1 FROM "__EFMigrationsHistory" WHERE "MigrationId" = '20260524042919_InitialPostgres') THEN
    CREATE TABLE "LegalPages" (
        "Id" integer GENERATED BY DEFAULT AS IDENTITY,
        "Slug" text NOT NULL,
        "Title" text NOT NULL,
        "Body" text NOT NULL,
        "LastRevised" date,
        "IsPublished" boolean NOT NULL,
        "UpdatedAt" timestamp without time zone NOT NULL,
        CONSTRAINT "PK_LegalPages" PRIMARY KEY ("Id")
    );
    END IF;
END $EF$;

DO $EF$
BEGIN
    IF NOT EXISTS(SELECT 1 FROM "__EFMigrationsHistory" WHERE "MigrationId" = '20260524042919_InitialPostgres') THEN
    CREATE TABLE "MediaFiles" (
        "Id" integer GENERATED BY DEFAULT AS IDENTITY,
        "FileName" text NOT NULL,
        "Url" text NOT NULL,
        "UploadedAt" timestamp without time zone NOT NULL,
        CONSTRAINT "PK_MediaFiles" PRIMARY KEY ("Id")
    );
    END IF;
END $EF$;

DO $EF$
BEGIN
    IF NOT EXISTS(SELECT 1 FROM "__EFMigrationsHistory" WHERE "MigrationId" = '20260524042919_InitialPostgres') THEN
    CREATE TABLE "PageSections" (
        "Id" integer GENERATED BY DEFAULT AS IDENTITY,
        "Page" text NOT NULL,
        "SectionKey" text NOT NULL,
        "ContentJson" text NOT NULL,
        "UpdatedAt" timestamp without time zone NOT NULL,
        CONSTRAINT "PK_PageSections" PRIMARY KEY ("Id")
    );
    END IF;
END $EF$;

DO $EF$
BEGIN
    IF NOT EXISTS(SELECT 1 FROM "__EFMigrationsHistory" WHERE "MigrationId" = '20260524042919_InitialPostgres') THEN
    CREATE TABLE "Roles" (
        "Id" integer GENERATED BY DEFAULT AS IDENTITY,
        "Name" text NOT NULL,
        CONSTRAINT "PK_Roles" PRIMARY KEY ("Id")
    );
    END IF;
END $EF$;

DO $EF$
BEGIN
    IF NOT EXISTS(SELECT 1 FROM "__EFMigrationsHistory" WHERE "MigrationId" = '20260524042919_InitialPostgres') THEN
    CREATE TABLE "Services" (
        "Id" integer GENERATED BY DEFAULT AS IDENTITY,
        "Title" text NOT NULL,
        "Description" text NOT NULL,
        "Price" numeric,
        "IconUrl" text,
        "ImageUrl" text,
        CONSTRAINT "PK_Services" PRIMARY KEY ("Id")
    );
    END IF;
END $EF$;

DO $EF$
BEGIN
    IF NOT EXISTS(SELECT 1 FROM "__EFMigrationsHistory" WHERE "MigrationId" = '20260524042919_InitialPostgres') THEN
    CREATE TABLE "Users" (
        "Id" integer GENERATED BY DEFAULT AS IDENTITY,
        "Email" text NOT NULL,
        "PasswordHash" text NOT NULL,
        "DisplayName" text NOT NULL,
        "IsActive" boolean NOT NULL,
        CONSTRAINT "PK_Users" PRIMARY KEY ("Id")
    );
    END IF;
END $EF$;

DO $EF$
BEGIN
    IF NOT EXISTS(SELECT 1 FROM "__EFMigrationsHistory" WHERE "MigrationId" = '20260524042919_InitialPostgres') THEN
    CREATE TABLE "RolePermissions" (
        "RoleId" integer NOT NULL,
        "Permission" text NOT NULL,
        CONSTRAINT "PK_RolePermissions" PRIMARY KEY ("RoleId", "Permission"),
        CONSTRAINT "FK_RolePermissions_Roles_RoleId" FOREIGN KEY ("RoleId") REFERENCES "Roles" ("Id") ON DELETE CASCADE
    );
    END IF;
END $EF$;

DO $EF$
BEGIN
    IF NOT EXISTS(SELECT 1 FROM "__EFMigrationsHistory" WHERE "MigrationId" = '20260524042919_InitialPostgres') THEN
    CREATE TABLE "RefreshTokens" (
        "Id" integer GENERATED BY DEFAULT AS IDENTITY,
        "UserId" integer NOT NULL,
        "Token" text NOT NULL,
        "ExpiresAt" timestamp without time zone NOT NULL,
        "CreatedAt" timestamp without time zone NOT NULL,
        CONSTRAINT "PK_RefreshTokens" PRIMARY KEY ("Id"),
        CONSTRAINT "FK_RefreshTokens_Users_UserId" FOREIGN KEY ("UserId") REFERENCES "Users" ("Id") ON DELETE CASCADE
    );
    END IF;
END $EF$;

DO $EF$
BEGIN
    IF NOT EXISTS(SELECT 1 FROM "__EFMigrationsHistory" WHERE "MigrationId" = '20260524042919_InitialPostgres') THEN
    CREATE TABLE "UserRoles" (
        "UserId" integer NOT NULL,
        "RoleId" integer NOT NULL,
        CONSTRAINT "PK_UserRoles" PRIMARY KEY ("UserId", "RoleId"),
        CONSTRAINT "FK_UserRoles_Roles_RoleId" FOREIGN KEY ("RoleId") REFERENCES "Roles" ("Id") ON DELETE CASCADE,
        CONSTRAINT "FK_UserRoles_Users_UserId" FOREIGN KEY ("UserId") REFERENCES "Users" ("Id") ON DELETE CASCADE
    );
    END IF;
END $EF$;

DO $EF$
BEGIN
    IF NOT EXISTS(SELECT 1 FROM "__EFMigrationsHistory" WHERE "MigrationId" = '20260524042919_InitialPostgres') THEN
    CREATE UNIQUE INDEX "IX_Articles_Slug" ON "Articles" ("Slug");
    END IF;
END $EF$;

DO $EF$
BEGIN
    IF NOT EXISTS(SELECT 1 FROM "__EFMigrationsHistory" WHERE "MigrationId" = '20260524042919_InitialPostgres') THEN
    CREATE UNIQUE INDEX "IX_LegalPages_Slug" ON "LegalPages" ("Slug");
    END IF;
END $EF$;

DO $EF$
BEGIN
    IF NOT EXISTS(SELECT 1 FROM "__EFMigrationsHistory" WHERE "MigrationId" = '20260524042919_InitialPostgres') THEN
    CREATE UNIQUE INDEX "IX_PageSections_Page_SectionKey" ON "PageSections" ("Page", "SectionKey");
    END IF;
END $EF$;

DO $EF$
BEGIN
    IF NOT EXISTS(SELECT 1 FROM "__EFMigrationsHistory" WHERE "MigrationId" = '20260524042919_InitialPostgres') THEN
    CREATE UNIQUE INDEX "IX_RefreshTokens_Token" ON "RefreshTokens" ("Token");
    END IF;
END $EF$;

DO $EF$
BEGIN
    IF NOT EXISTS(SELECT 1 FROM "__EFMigrationsHistory" WHERE "MigrationId" = '20260524042919_InitialPostgres') THEN
    CREATE INDEX "IX_RefreshTokens_UserId" ON "RefreshTokens" ("UserId");
    END IF;
END $EF$;

DO $EF$
BEGIN
    IF NOT EXISTS(SELECT 1 FROM "__EFMigrationsHistory" WHERE "MigrationId" = '20260524042919_InitialPostgres') THEN
    CREATE INDEX "IX_UserRoles_RoleId" ON "UserRoles" ("RoleId");
    END IF;
END $EF$;

DO $EF$
BEGIN
    IF NOT EXISTS(SELECT 1 FROM "__EFMigrationsHistory" WHERE "MigrationId" = '20260524042919_InitialPostgres') THEN
    CREATE UNIQUE INDEX "IX_Users_Email" ON "Users" ("Email");
    END IF;
END $EF$;

DO $EF$
BEGIN
    IF NOT EXISTS(SELECT 1 FROM "__EFMigrationsHistory" WHERE "MigrationId" = '20260524042919_InitialPostgres') THEN
    INSERT INTO "__EFMigrationsHistory" ("MigrationId", "ProductVersion")
    VALUES ('20260524042919_InitialPostgres', '9.0.4');
    END IF;
END $EF$;

COMMIT;

