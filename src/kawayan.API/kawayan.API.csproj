<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>kawayan.API</AssemblyName>
    <RootNamespace>kawayan.API</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Exclude only user uploads from glob; excluding all wwwroot prevented publish from deploying built SPA files. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);wwwroot\uploads\**</DefaultItemExcludes>
    <SkipSpaBuild Condition="'$(SkipSpaBuild)' == ''">false</SkipSpaBuild>
  </PropertyGroup>

  <PropertyGroup>
    <FrontendProjectName>kawayan.Web</FrontendProjectName>
    <FrontendDir>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../$(FrontendProjectName)'))</FrontendDir>
    <FrontendDistDir>$(FrontendDir)/dist</FrontendDistDir>
    <WwwRootDir>$(MSBuildProjectDirectory)/wwwroot</WwwRootDir>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../$(FrontendProjectName)/**" Exclude="../$(FrontendProjectName)/node_modules/**;../$(FrontendProjectName)/dist/**" />
    <Content Update="$(WwwRootDir)/uploads/**" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.S3" Version="4.0.23.4" />
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <PackageReference Include="ClosedXML" Version="0.104.2" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.4" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.4">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.0.4" />
    <PackageReference Include="QuestPDF" Version="2025.1.2" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="7.3.1" />
  </ItemGroup>

  <Target Name="NpmInstall" BeforeTargets="BuildFrontend" Condition="'$(SkipSpaBuild)' != 'true'" Inputs="$(FrontendDir)/package.json;$(FrontendDir)/package-lock.json" Outputs="$(FrontendDir)/node_modules/.package-lock.json">
    <Message Text="[Pipeline] Installing npm dependencies..." Importance="high" />
    <Exec Command="npm ci" WorkingDirectory="$(FrontendDir)" />
  </Target>

  <!-- PrepareForPublish: VS / dotnet publish must rebuild SPA even when CoreCompile is skipped. -->
  <Target Name="BuildFrontend" BeforeTargets="BeforeBuild;PrepareForPublish" Condition="'$(SkipSpaBuild)' != 'true'">
    <Message Text="[Pipeline] Building frontend..." Importance="high" />
    <Exec Command="npm run build" WorkingDirectory="$(FrontendDir)" />
  </Target>

  <Target Name="CleanWwwRoot" AfterTargets="BuildFrontend" BeforeTargets="CopyFrontendToWwwRoot" Condition="'$(SkipSpaBuild)' != 'true'">
    <Message Text="[Pipeline] Cleaning wwwroot..." Importance="high" />
    <RemoveDir Directories="$(WwwRootDir)/assets" Condition="Exists('$(WwwRootDir)/assets')" />
    <Delete Files="$(WwwRootDir)/index.html" Condition="Exists('$(WwwRootDir)/index.html')" />
    <MakeDir Directories="$(WwwRootDir)" Condition="!Exists('$(WwwRootDir)')" />
    <MakeDir Directories="$(WwwRootDir)/uploads" Condition="!Exists('$(WwwRootDir)/uploads')" />
  </Target>

  <Target Name="CopyFrontendToWwwRoot" AfterTargets="CleanWwwRoot" Condition="'$(SkipSpaBuild)' != 'true'">
    <ItemGroup>
      <FrontendDistFiles Include="$(FrontendDistDir)/**/*" />
    </ItemGroup>
    <Message Text="[Pipeline] Copying frontend dist to wwwroot..." Importance="high" />
    <Copy SourceFiles="@(FrontendDistFiles)" DestinationFiles="@(FrontendDistFiles->'$(WwwRootDir)/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="false" />
  </Target>

  <Target Name="CleanCompressedCache" AfterTargets="CopyFrontendToWwwRoot" BeforeTargets="PrepareForPublish" Condition="'$(SkipSpaBuild)' != 'true'">
    <Message Text="[Pipeline] Clearing compressed asset cache..." Importance="high" />
    <RemoveDir Directories="$(IntermediateOutputPath)compressed" Condition="Exists('$(IntermediateOutputPath)compressed')" />
  </Target>

</Project>
